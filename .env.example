# Copy this file to .env.local and fill in real values.

# Resend (https://resend.com) API key used by /api/contact to send the contact form's
# messages as real email. Without this set, submissions are accepted and logged to the
# server console instead of being emailed — useful for local development, not for production.
RESEND_API_KEY=re_your_api_key_here

# Where contact form submissions should be delivered. Defaults to devallianceforge@gmail.com
# if unset.
CONTACT_TO_EMAIL=devallianceforge@gmail.com

# Optional. A GitHub personal access token with no scopes (public data only) used by
# src/lib/github.ts to raise the API rate limit from 60/hour (unauthenticated) to 5,000/hour.
# The /projects page's live org stats work fine without this at low traffic — only needed if
# you see those stats disappear under real production load.
GITHUB_TOKEN=

# ── MCP Server API Keys ───────────────────────────────────────────────
# Context7 MCP server (https://context7.com)
CTX7_API_KEY=

# 21st.dev MCP server (https://21st.dev/api/mcp)
TWENTYFIRST_API_KEY=
